# ============================================
# Stock Management System - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ---- Database (MySQL) ----
DB_NAME=stock_management
DB_USER=inventory_user
DB_PASSWORD=your_strong_password_here
DB_HOST=localhost
DB_PORT=3306

# ---- JWT Configuration ----
# Generate a unique secret: openssl rand -base64 48
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Optional first-run administrator. Created only when there are no users.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ---- Backend Server ----
SERVER_PORT=8080
SHOW_SQL=false
LOG_LEVEL=INFO

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---- Docker Compose ----
# These are used by docker-compose.yml
DB_URL=jdbc:mysql://mysql:3306/stock_management?useSSL=false&allowPublicKeyRetrieval=true
