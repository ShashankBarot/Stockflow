# ============================================
# Stock Management System - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ---- Database (MySQL) ----
DB_NAME=stock_management
DB_USER=inventory_user
DB_PASSWORD=your_strong_password_here
DB_HOST=localhost
DB_PORT=3306

# ---- JWT Configuration ----
# IMPORTANT: Change this to a long, random, secure string in production!
# Generate with: openssl rand -base64 64
JWT_SECRET=change_this_to_a_very_long_secure_random_string_in_production
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ---- Backend Server ----
SERVER_PORT=8080
SHOW_SQL=false
LOG_LEVEL=INFO

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---- Docker Compose ----
# These are used by docker-compose.yml
DB_URL=jdbc:mysql://mysql:3306/stock_management?useSSL=false&allowPublicKeyRetrieval=true
