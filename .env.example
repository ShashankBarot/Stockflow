# Copy to .env and replace every placeholder before deployment.
# Generate independent secrets, for example: openssl rand -base64 48

# ---- Database (MySQL) ----
DB_NAME=stock_management
DB_USER=inventory_user
DB_PASSWORD=replace_with_a_unique_database_password
DB_ROOT_PASSWORD=replace_with_a_different_unique_root_password
DB_PORT=3306

# ---- JWT Configuration ----
# Generate a unique secret: openssl rand -base64 48
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Optional first-run administrator. Created only when there are no users.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters

# ---- Backend Server ----
SERVER_PORT=8080
SHOW_SQL=false
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend and backend ports bind to loopback by default. Put a TLS reverse proxy
# in front of them for remote access; do not expose MySQL publicly.
FRONTEND_PORT=3000
