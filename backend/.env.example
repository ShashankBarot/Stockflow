# Backend-only local development environment. For Docker Compose, configure the
# root .env file instead (compose supplies the database host and prod profile).
DB_URL=jdbc:mysql://localhost:3306/stock_management?useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=inventory_user
DB_PASSWORD=replace_with_database_password
SERVER_PORT=8080
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
SHOW_SQL=false
LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000
